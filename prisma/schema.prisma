generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model dashboard_user {
  id Int @id @default(autoincrement())

  email     String  @unique
  password  String
  is_active Boolean @default(true)
  role_name String
  name      String?

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  role    role @relation(fields: [role_id], references: [id])
  role_id Int

  @@index([role_id])
  @@map("users")
}

model site_feature {
  id Int @id @default(autoincrement())

  name     String
  path     String  @unique
  enabled  Boolean
  is_super Boolean @default(false)

  site_feature_roles site_feature_role[]
}

model role {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  is_active Boolean @default(true)

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  users              dashboard_user[]
  site_feature_roles site_feature_role[]

  @@map("roles")
}

model site_feature_role {
  site_feature_id Int
  role_id         Int

  access_crud Json

  site_feature site_feature @relation(fields: [site_feature_id], references: [id])
  role         role         @relation(fields: [role_id], references: [id])

  @@id([site_feature_id, role_id])
  @@map("site_feature_role")
}

model site_config {
  id          Int     @id @default(autoincrement())
  name        String
  tagline     String?
  description String?
  site_url    String?

  topbar_message     String?

  light_logo_url  String?
  dark_logo_url   String?
  favicon_url     String?
  primary_color   String  @default("#18181b")
  secondary_color String  @default("#27272a")
  accent_color    String  @default("#f59e0b")
  font_family     String  @default("Inter")
  custom_css      String? @db.Text

  header_config Json @default("{}")
  footer_config Json @default("{}")

  currency        String @default("USD")
  currency_symbol String @default("$")

  email   String?
  phone   String?
  address String?

  social_links Json @default("{}")

  business_name                String?
  business_registration_number String?
  tax_rate                     Decimal? @db.Decimal(5, 4)
  tax_inclusive                Boolean  @default(false)
  tax_label                    String   @default("Tax")

  require_phone     Boolean @default(false)
  allow_order_notes Boolean @default(true)
  captcha_provider  String  @default("none")

  meta_info Json @default("{}")

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@map("site_config")
}

model site_page {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  title String

  content   String? @db.Text
  is_active Boolean @default(true)

  show_in_header Boolean @default(false)
  show_in_footer Boolean @default(true)
  sort_order     Int     @default(0)

  meta_info         Json @default("{}")
  theme_config      Json @default("{}")
  components_config Json @default("[]")

  created_at DateTime @default(now())
  created_by Int
  updated_at DateTime @updatedAt
  updated_by Int

  @@index([is_active, show_in_header])
  @@index([is_active, show_in_footer])
  @@map("site_pages")
}

model site_component {
  id            Int     @id @default(autoincrement())
  name          String
  component_key String  @unique
  category      String  @default("section")
  description   String?
  default_props Json    @default("{}")
  thumbnail_url String?
  is_active     Boolean @default(true)

  created_at DateTime @default(now())
  created_by Int      @default(1)
  updated_at DateTime @updatedAt
  updated_by Int      @default(1)

  @@index([is_active])
  @@map("site_components")
}

model email_config {
  id Int @id @default(autoincrement())

  provider String @default("smtp")

  from_name      String
  from_email     String
  reply_to_email String?

  send_order_confirmation  Boolean @default(true)
  send_shipping_update     Boolean @default(true)
  send_admin_new_order     Boolean @default(true)
  admin_notification_email String?

  include_pdf_invoice Boolean @default(false)

  is_active Boolean @default(true)

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@map("email_config")
}

model email_template {
  id Int @id @default(autoincrement())

  key                 String
  name                String
  description         String?
  subject             String
  body_html           String  @db.Text
  available_variables Json?

  is_active Boolean @default(false)

  created_at DateTime  @default(now())
  created_by Int       @default(1)
  updated_at DateTime  @updatedAt
  updated_by Int       @default(1)
  deleted_at DateTime?
  deleted_by Int?

  @@index([key])
  @@index([is_active])
  @@index([deleted_at])
  @@map("email_templates")
}

model shipping_method {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  free_over   Decimal? @db.Decimal(10, 2)

  estimated_days_min Int?
  estimated_days_max Int?

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  orders order[]

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@map("shipping_methods")
}

model payment_method {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  provider        String
  provider_config Json?

  extra_charge Decimal? @db.Decimal(10, 2)
  instructions String?  @db.Text

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  orders order[]

  created_at DateTime @default(now())
  created_by Int
  updated_at DateTime @updatedAt
  updated_by Int

  @@index([provider])
  @@index([is_active])
  @@map("payment_methods")
}

model coupon {
  id   Int    @id @default(autoincrement())
  code String @unique

  discount_type  String
  discount_value Decimal @db.Decimal(10, 2)

  minimum_order_amount Decimal? @db.Decimal(10, 2)
  max_uses             Int?
  max_uses_per_email   Int      @default(1)
  times_used           Int      @default(0)

  starts_at  DateTime  @default(now())
  expires_at DateTime?
  is_active  Boolean   @default(true)

  orders order[]

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@map("coupons")
}

model order {
  id           Int    @id @default(autoincrement())
  order_number String @unique

  customer_email      String
  customer_first_name String
  customer_last_name  String
  customer_phone      String?
  customer_ip         String?
  customer_user_agent String?

  billing_address_line1 String
  billing_address_line2 String?
  billing_city          String
  billing_state         String?
  billing_postal_code   String
  billing_country       String

  shipping_address_line1 String
  shipping_address_line2 String?
  shipping_city          String
  shipping_state         String?
  shipping_postal_code   String
  shipping_country       String

  shipping_method_id   Int?
  shipping_method      shipping_method? @relation(fields: [shipping_method_id], references: [id])
  shipping_method_name String
  shipping_cost        Decimal          @db.Decimal(10, 2)

  coupon_id       Int?
  coupon          coupon? @relation(fields: [coupon_id], references: [id])
  coupon_code     String?
  discount_amount Decimal @default(0) @db.Decimal(10, 2)

  subtotal   Decimal @db.Decimal(10, 2)
  tax_amount Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @db.Decimal(10, 2)
  currency   String  @default("USD")

  payment_method_id   Int?
  payment_method_ref  payment_method? @relation(fields: [payment_method_id], references: [id])
  payment_method      String
  payment_method_name String          @default("")
  payment_status      String          @default("pending")

  fulfillment_status String @default("unfulfilled")

  tracking_number String?
  tracking_url    String?
  carrier_name    String?
  shipped_at      DateTime?
  delivered_at    DateTime?

  admin_notes    String?
  customer_notes String?

  confirmation_sent_at DateTime?
  shipping_notified_at DateTime?

  items       order_item[]
  payments    payment_transaction[]
  refunds     order_refund[]
  invoice     invoice?
  sent_emails sent_email[]

  placed_at    DateTime  @default(now())
  paid_at      DateTime?
  cancelled_at DateTime?

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@index([shipping_method_id])
  @@index([payment_method_id])
  @@index([coupon_id])
  @@index([customer_email])
  @@index([payment_status])
  @@index([fulfillment_status])
  @@index([placed_at])
  @@map("orders")
}

model order_item {
  id       Int   @id @default(autoincrement())
  order_id Int
  order    order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  product_id Int?
  product    product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  variant_id Int?
  variant    product_variant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  product_name String
  variant_name String?
  sku          String?
  unit_price   Decimal @db.Decimal(10, 2)
  quantity     Int
  line_total   Decimal @db.Decimal(10, 2)

  options   Json?
  image_url String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([variant_id])
  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model payment_transaction {
  id       Int   @id @default(autoincrement())
  order_id Int
  order    order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  provider                String
  provider_transaction_id String?
  provider_session_id     String?
  provider_status         String?

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  status String @default("pending")

  raw_response Json?

  confirmed_by Int?
  confirmed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([order_id])
  @@index([provider_transaction_id])
  @@map("payment_transactions")
}

model order_refund {
  id       Int   @id @default(autoincrement())
  order_id Int
  order    order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  amount             Decimal @db.Decimal(10, 2)
  reason             String?
  provider_refund_id String?

  status      String    @default("pending")
  refunded_at DateTime?

  created_at DateTime @default(now())
  created_by Int
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([order_id])
  @@map("order_refunds")
}

model category {
  id             Int     @id @default(autoincrement())
  name           String
  slug           String  @unique
  description    String?
  image_url      String?
  image_alt_text String?

  bg_color String? @default("from-zinc-800 to-zinc-950")

  show_in_header Boolean @default(true)
  show_in_footer Boolean @default(true)
  show_in_home   Boolean @default(true)

  product_count Int  @default(0)
  meta_info     Json @default("{}")

  parent_id Int?
  parent    category?  @relation("SubCategories", fields: [parent_id], references: [id])
  children  category[] @relation("SubCategories")

  products   product[]
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@index([parent_id])
  @@index([is_active, show_in_header])
  @@index([is_active, show_in_footer])
  @@index([is_active, show_in_home])
  @@map("categories")
}

model product {
  id                Int     @id @default(autoincrement())
  name              String
  slug              String  @unique
  description       String? @db.Text
  short_description String?
  category_name     String?

  feature_image_url      String?
  feature_image_alt_text String?

  price            Decimal  @db.Decimal(10, 2)
  compare_at_price Decimal? @db.Decimal(10, 2)
  cost_price       Decimal? @db.Decimal(10, 2)

  sku                 String? @unique
  stock_quantity      Int     @default(0)
  low_stock_threshold Int     @default(5)
  track_inventory     Boolean @default(true)

  weight     Decimal? @db.Decimal(8, 2)
  dimensions Json?

  category_id Int?
  category    category?         @relation(fields: [category_id], references: [id])
  images      product_image[]
  variants    product_variant[]

  is_featured Boolean @default(false)
  is_active   Boolean @default(true)
  sort_order  Int     @default(0)

  meta_info Json @default("{}")

  created_at  DateTime     @default(now())
  created_by  Int
  updated_at  DateTime     @updatedAt
  updated_by  Int
  deleted_at  DateTime?
  deleted_by  Int?
  order_items order_item[]

  @@index([category_id])
  @@index([is_featured])
  @@index([is_active])
  @@map("products")
}

model product_image {
  id         Int     @id @default(autoincrement())
  product_id Int
  product    product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  url        String
  alt_text   String?
  sort_order Int     @default(0)

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@index([product_id])
  @@map("product_images")
}

model product_variant {
  id         Int     @id @default(autoincrement())
  product_id Int
  product    product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  name String
  sku  String? @unique

  price            Decimal? @db.Decimal(10, 2)
  compare_at_price Decimal? @db.Decimal(10, 2)

  stock_quantity     Int     @default(0)
  options            Json
  image_url          String?
  image_url_alt_text String?

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  created_at  DateTime     @default(now())
  created_by  Int
  updated_at  DateTime     @updatedAt
  updated_by  Int
  deleted_at  DateTime?
  deleted_by  Int?
  order_items order_item[]

  @@index([product_id])
  @@map("product_variants")
}

model newsletter_subscriber {
  id    Int    @id @default(autoincrement())
  email String @unique

  created_at DateTime @default(now())

  @@map("newsletter_subscribers")
}

model invoice {
  id             Int    @id @default(autoincrement())
  invoice_number String @unique

  order_id Int   @unique
  order    order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  status String @default("issued")

  customer_name  String
  customer_email String

  billing_address  Json?
  shipping_address Json?

  subtotal        Decimal @db.Decimal(10, 2)
  tax_amount      Decimal @default(0) @db.Decimal(10, 2)
  shipping_cost   Decimal @default(0) @db.Decimal(10, 2)
  discount_amount Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  currency        String  @default("USD")

  issued_at DateTime  @default(now())
  paid_at   DateTime?
  due_at    DateTime?

  notes String? @db.Text

  sent_emails sent_email[]

  created_at DateTime  @default(now())
  created_by Int
  updated_at DateTime  @updatedAt
  updated_by Int
  deleted_at DateTime?
  deleted_by Int?

  @@index([order_id])
  @@index([status])
  @@index([customer_email])
  @@map("invoices")
}

model sent_email {
  id Int @id @default(autoincrement())

  type            String    @default("invoice")
  sender_email    String
  recipient_email String
  recipient_name  String?
  subject         String
  order_number    String?
  status          String    @default("pending")
  sent_at         DateTime? @default(now())
  error_message   String?   @db.Text
  body_html       String    @db.Text

  invoice_id Int?
  invoice    invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  order_id Int?
  order    order? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([recipient_email])
  @@index([status])
  @@index([order_number])
  @@index([invoice_id])
  @@index([order_id])
  @@map("sent_emails")
}

model order_otp_verification {
  id Int @id @default(autoincrement())

  type          String   @default("cod_confirmation")
  email         String
  order_number  String?
  otp_code      String
  order_payload Json?
  attempts      Int      @default(0)
  expires_at    DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([order_number])
  @@index([type])
  @@index([expires_at])
  @@map("order_otp_verifications")
}

model activity_log {
  id          Int      @id @default(autoincrement())
  action      String
  entity_type String
  entity_id   String?
  user_id     Int?
  user_email  String?
  user_role   String?
  status      String   @default("SUCCESS")
  details     Json?    @default("{}")
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([action])
  @@index([created_at])
  @@map("activity_logs")
}

